# Salin menjadi .env untuk menjalankan di laptop (npm start). Di Vercel, isi lewat Settings → Environment Variables.

# Admin pertama (hanya dipakai saat database masih kosong). Ganti password setelah login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-panjang

# Opsional di laptop: kosongkan untuk memakai database lokal di folder data/ (PGlite).
# Di Vercel diisi otomatis oleh integrasi Neon.
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
